# ─── Database ─────────────────────────────────────────────────────────────────
# Jika dikosongkan atau mengarah ke localhost yang tidak aktif,
# aplikasi otomatis menggunakan PGlite (database in-process) sebagai fallback.
DATABASE_URL=postgresql://user:password@localhost:5432/clovet

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Ganti dengan string random yang panjang (minimal 32 karakter) di production.
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars

# ─── Python (NLP) ─────────────────────────────────────────────────────────────
PYTHON_PATH=python3

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Keys Eksternal (BELUM DIIMPLEMENTASIKAN) ─────────────────────────────
# Ketiga key di bawah ini adalah placeholder untuk pengembangan selanjutnya.
# Belum ada kode backend yang memanggilnya — aktifkan saat integrasi nyata dibuat.
# PENTING: Simpan di sini (backend only) — JANGAN pernah expose ke frontend.

# GEMINI_API_KEY=your_gemini_api_key
# Digunakan nanti untuk: NLP klasifikasi produk berbasis AI (menggantikan keyword matching)

# MIDTRANS_SERVER_KEY=your_midtrans_key
# Digunakan nanti untuk: integrasi payment gateway (escrow, disbursement)

# RAJAONGKIR_API_KEY=your_rajaongkir_key
# Digunakan nanti untuk: tracking kurir real-time (sinkronisasi nomor resi)
